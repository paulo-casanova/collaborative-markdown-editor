#!/usr/bin/env python3
"""
CME Local Agent CLI Daemon (cme-agent)
Bridges local workstation resources (Gemini, Ollama, Anthropic, OpenAI, custom LLMs, git, shell)
with Collaborative Markdown Editor (CME) dialog sessions over an outbound WebSocket tunnel.
"""

import sys
import os
import json
import time
import socket
import argparse
import asyncio
import subprocess
import inspect
import shlex
import shutil
import re
import urllib.request
import urllib.parse
import urllib.error
from typing import Optional, Dict, Any, List

try:
    import websockets
except ImportError:
    print("Error: 'websockets' package is required. Install via: pip install websockets", file=sys.stderr)
    sys.exit(1)


class CMEAgentDaemon:
    def __init__(
        self,
        server_url: str,
        token: Optional[str] = None,
        agent_name: str = f"{socket.gethostname()}-agent",
        provider: str = "auto",
        model: Optional[str] = None,
        api_key: Optional[str] = None,
        api_base: Optional[str] = None,
        ollama_host: str = "http://localhost:11434",
        allowed_tools: Optional[List[str]] = None,
        workspace_dir: Optional[str] = None,
        auth_command: Optional[str] = None,
        headers: Optional[List[str]] = None,
        header_cmd: Optional[str] = None,
        command: Optional[str] = None,
    ):
        self.server_url = server_url.rstrip("/")
        self.token = token or ""
        self.agent_name = agent_name
        self.provider = provider.lower()
        self.model = model
        self.api_key = api_key
        self.api_base = api_base
        self.ollama_host = ollama_host.rstrip("/")
        self.allowed_tools = set(allowed_tools or ["git", "grep", "filesystem"])
        self.workspace_dir = os.path.abspath(workspace_dir or os.getcwd())
        self.auth_command = auth_command
        self.headers = headers or []
        self.header_cmd = header_cmd
        self.command = command
        self.running = True

        # Canonicalize provider aliases for command-line agent
        if self.provider in ("cli", "claude", "cmd", "exec"):
            self.provider = "command"
        if self.command and self.provider == "auto":
            self.provider = "command"

        if self.provider == "command" and not self.command:
            self.command = "claude -p --output-format stream-json --verbose"

        # Default model selection based on provider
        if not self.model:
            if self.provider == "gemini":
                self.model = "gemini-1.5-flash"
            elif self.provider == "anthropic":
                self.model = "claude-3-5-sonnet-20241022"
            elif self.provider == "openai":
                self.model = "gpt-4o"
            elif self.provider == "command":
                self.model = "command-cli"
            else:
                self.model = "llama3.1"

    def _detect_provider(self) -> str:
        if self.provider in ("cli", "claude", "cmd", "exec"):
            return "command"
        if self.provider != "auto":
            return self.provider

        if self.command:
            return "command"

        # 1. Check Google Gemini
        if self.api_key or os.environ.get("GEMINI_API_KEY"):
            return "gemini"

        # 2. Check Anthropic
        if os.environ.get("ANTHROPIC_API_KEY"):
            return "anthropic"

        # 3. Check OpenAI
        if os.environ.get("OPENAI_API_KEY"):
            return "openai"

        # 4. Check if Ollama is running locally
        try:
            req = urllib.request.Request(f"{self.ollama_host}/api/tags", method="GET")
            with urllib.request.urlopen(req, timeout=1.0) as resp:
                if resp.status == 200:
                    return "ollama"
        except Exception:
            pass

        return "echo"

    def _get_api_key(self, provider: str) -> Optional[str]:
        if self.api_key:
            return self.api_key
        if provider == "gemini":
            return os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
        if provider == "anthropic":
            return os.environ.get("ANTHROPIC_API_KEY")
        if provider == "openai":
            return os.environ.get("OPENAI_API_KEY")
        if provider == "custom":
            return os.environ.get("OPENAI_API_KEY") or os.environ.get("API_KEY")
        return None

    def validate_provider(self):
        """Validates that explicitly selected provider has required credentials/connectivity before starting."""
        if not self.token and not self.auth_command and not self.headers and not self.header_cmd:
            print(
                "\n[FATAL] Missing credentials: You must supply either --token, --auth-command, --header-cmd, or --header (e.g. X-Remote-User for delegated auth).\n",
                file=sys.stderr,
            )
            sys.exit(1)

        prov = self.provider.lower()
        if prov in ("auto", "echo"):
            return

        if prov == "command":
            cmd = self.command or "claude -p --output-format stream-json --verbose"
            try:
                parts = shlex.split(cmd)
                prog = parts[0] if parts else ""
                if prog and not shutil.which(prog):
                    print(
                        f"\n[WARN] Command-line executable '{prog}' was not found in PATH.\n"
                        f"  Please ensure '{prog}' is installed and accessible in your shell environment.\n",
                        file=sys.stderr,
                    )
            except Exception:
                pass
            return

        if prov == "gemini":
            key = self._get_api_key("gemini")
            if not key:
                print(
                    "\n[FATAL] Provider 'gemini' was requested, but no GEMINI_API_KEY or GOOGLE_API_KEY was found.\n\n"
                    "  Google Antigravity (agy) uses personal Google OAuth, which is separate from the developer API key.\n"
                    "  To use Google Gemini in cme-agent, you need an API key from Google AI Studio:\n\n"
                    "    1. Get a free API key at: https://aistudio.google.com/app/apikey\n"
                    "    2. Set the environment variable or pass --api-key:\n"
                    "         export GEMINI_API_KEY=\"AIzaSy...\"\n"
                    "         cme-agent ... --provider gemini\n"
                    "       or:\n"
                    "         cme-agent ... --provider gemini --api-key \"AIzaSy...\"\n",
                    file=sys.stderr,
                )
                sys.exit(1)
        elif prov == "anthropic":
            key = self._get_api_key("anthropic")
            if not key:
                print(
                    "\n[FATAL] Provider 'anthropic' was requested, but no ANTHROPIC_API_KEY was found.\n"
                    "  Set with: export ANTHROPIC_API_KEY=\"sk-ant-...\" or pass --api-key <KEY>\n",
                    file=sys.stderr,
                )
                sys.exit(1)
        elif prov == "openai":
            key = self._get_api_key("openai")
            if not key:
                print(
                    "\n[FATAL] Provider 'openai' was requested, but no OPENAI_API_KEY was found.\n"
                    "  Set with: export OPENAI_API_KEY=\"sk-...\" or pass --api-key <KEY>\n",
                    file=sys.stderr,
                )
                sys.exit(1)
        elif prov == "ollama":
            try:
                req = urllib.request.Request(f"{self.ollama_host}/api/tags", method="GET")
                with urllib.request.urlopen(req, timeout=2.0) as resp:
                    pass
            except Exception as e:
                print(
                    f"\n[FATAL] Provider 'ollama' was requested, but could not connect to {self.ollama_host}: {e}\n"
                    "  Please ensure Ollama is installed and running (`ollama serve`).\n",
                    file=sys.stderr,
                )
                sys.exit(1)
        elif prov not in ("custom",):
            print(f"\n[FATAL] Unknown provider '{self.provider}'. Supported providers: gemini, ollama, anthropic, openai, command, custom, echo\n", file=sys.stderr)
            sys.exit(1)

    def _fetch_token_from_auth_command(self) -> str:
        if not self.auth_command:
            return ""
        try:
            res = subprocess.run(
                self.auth_command,
                shell=True,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=30.0,
            )
            tok = res.stdout.strip()
            if not tok:
                print(f"[AGENT] Warning: Auth command '{self.auth_command}' returned empty token.", file=sys.stderr)
            return tok
        except subprocess.CalledProcessError as e:
            print(f"[AGENT] Error running auth command (code {e.returncode}): {e.stderr.strip()}", file=sys.stderr)
            raise
        except Exception as e:
            print(f"[AGENT] Failed to run auth command '{self.auth_command}': {e}", file=sys.stderr)
            raise

    def _fetch_headers_from_cmd(self) -> Dict[str, str]:
        if not self.header_cmd:
            return {}
        try:
            res = subprocess.run(
                self.header_cmd,
                shell=True,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=30.0,
            )
            raw = res.stdout.strip()
            if not raw:
                print(f"[AGENT] Warning: Header command '{self.header_cmd}' returned empty output.", file=sys.stderr)
                return {}

            # Attempt JSON parsing if wrapped in braces or brackets
            if (raw.startswith("{") and raw.endswith("}")) or (raw.startswith("[") and raw.endswith("]")):
                try:
                    parsed = json.loads(raw)
                    if isinstance(parsed, dict):
                        return {str(k): str(v) for k, v in parsed.items()}
                    elif isinstance(parsed, list):
                        res_dict = {}
                        for item in parsed:
                            if isinstance(item, str) and ":" in item:
                                k, v = item.split(":", 1)
                                res_dict[k.strip()] = v.strip()
                            elif isinstance(item, dict) and "name" in item and "value" in item:
                                res_dict[str(item["name"]).strip()] = str(item["value"]).strip()
                        return res_dict
                except json.JSONDecodeError:
                    pass

            # Otherwise parse line-delimited headers: "Header-Name: Header-Value" or "Header-Name=Header-Value"
            dynamic_headers = {}
            for line in raw.splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if ":" in line:
                    k, v = line.split(":", 1)
                    dynamic_headers[k.strip()] = v.strip()
                elif "=" in line:
                    k, v = line.split("=", 1)
                    dynamic_headers[k.strip()] = v.strip()
            return dynamic_headers
        except subprocess.CalledProcessError as e:
            print(f"[AGENT] Error running header command (code {e.returncode}): {e.stderr.strip()}", file=sys.stderr)
            raise
        except Exception as e:
            print(f"[AGENT] Failed to run header command '{self.header_cmd}': {e}", file=sys.stderr)
            raise

    async def run(self):
        ws_base = self.server_url.replace("http://", "ws://").replace("https://", "wss://")

        active_prov = self._detect_provider()
        effective_model = self.model or ("gemini-1.5-flash" if active_prov == "gemini" else ("command-cli" if active_prov == "command" else "llama3.1"))

        print("=" * 60)
        print("  CME Local Agent Daemon (cme-agent)")
        print(f"  Name:      {self.agent_name}")
        print(f"  Server:    {self.server_url}")
        print(f"  Workspace: {self.workspace_dir}")
        print(f"  Tools:     {', '.join(sorted(self.allowed_tools))}")
        print(f"  Provider:  {active_prov} ({effective_model})")
        if active_prov == "command":
            print(f"  Command:   {self.command or 'claude -p --output-format stream-json --verbose'}")
        if self.api_base:
            print(f"  API Base:  {self.api_base}")
        if self.auth_command:
            print(f"  Auth Cmd:  {self.auth_command}")
        if self.header_cmd:
            print(f"  Header Cmd: {self.header_cmd}")
        if self.headers:
            print(f"  Headers:   {len(self.headers)} custom header(s)")
        print("=" * 60)

        # Parse static headers from CLI
        parsed_headers = {}
        for h in self.headers:
            if ":" in h:
                k, v = h.split(":", 1)
                parsed_headers[k.strip()] = v.strip()
            elif "=" in h:
                k, v = h.split("=", 1)
                parsed_headers[k.strip()] = v.strip()

        backoff = 1.0
        while self.running:
            try:
                current_token = self.token
                if self.auth_command:
                    try:
                        current_token = self._fetch_token_from_auth_command()
                        print(f"[AGENT] Retrieved fresh agent token from auth-command.")
                    except Exception as e:
                        print(f"[AGENT] Auth command failed: {e}. Retrying in {backoff:.1f}s...")
                        await asyncio.sleep(backoff)
                        backoff = min(backoff * 1.5, 30.0)
                        continue

                active_headers = dict(parsed_headers)
                if self.header_cmd:
                    try:
                        dyn_headers = self._fetch_headers_from_cmd()
                        active_headers.update(dyn_headers)
                        print(f"[AGENT] Retrieved {len(dyn_headers)} header(s) from header-cmd.")
                    except Exception as e:
                        print(f"[AGENT] Header command failed: {e}. Retrying in {backoff:.1f}s...")
                        await asyncio.sleep(backoff)
                        backoff = min(backoff * 1.5, 30.0)
                        continue

                query_params = {"name": self.agent_name}
                if current_token:
                    query_params["token"] = current_token

                ws_endpoint = f"{ws_base}/api/v1/agents/ws?{urllib.parse.urlencode(query_params)}"

                connect_kwargs = {
                    "ping_interval": 20,
                    "ping_timeout": 20,
                    "max_size": 16 * 1024 * 1024,
                }
                if active_headers:
                    sig = inspect.signature(websockets.connect)
                    if "additional_headers" in sig.parameters:
                        connect_kwargs["additional_headers"] = active_headers
                    else:
                        connect_kwargs["extra_headers"] = active_headers

                print(f"\n[AGENT] Connecting outbound to CME gateway at {self.server_url}...")
                async with websockets.connect(
                    ws_endpoint,
                    **connect_kwargs,
                ) as ws:
                    backoff = 1.0
                    print(f"[AGENT] Connection established. Listening for prompt requests...")

                    async for message in ws:
                        try:
                            data = json.loads(message)
                            msg_type = data.get("type", "")

                            if msg_type == "agent_ack":
                                print(f"[AGENT] Handshake acknowledged by server: version={data.get('server_version')}")
                            elif msg_type == "ping":
                                await ws.send(json.dumps({"type": "pong"}))
                            elif msg_type == "prompt_request":
                                asyncio.create_task(self.handle_prompt_request(ws, data))
                            else:
                                print(f"[AGENT] Received unhandled frame type: {msg_type}")
                        except Exception as e:
                            print(f"[AGENT] Error parsing frame: {e}", file=sys.stderr)

            except (websockets.exceptions.ConnectionClosedError, ConnectionRefusedError, OSError) as e:
                if not self.running:
                    break
                print(f"[AGENT] Connection lost: {e}. Reconnecting in {backoff:.1f}s...")
                await asyncio.sleep(backoff)
                backoff = min(backoff * 1.5, 30.0)
            except Exception as e:
                print(f"[AGENT] Unexpected error: {e}", file=sys.stderr)
                await asyncio.sleep(5.0)

    def _build_system_instructions(self, context: Dict[str, Any]) -> str:
        doc_id = context.get("document_id", "")
        doc_title = context.get("document_title", "")
        doc_path = context.get("document_path", "")
        raw_content = context.get("document_content", "")
        raw_sel = context.get("selected_text", "")

        # Sanitize doc_content: ensure it is a valid markdown string, not an AST or [object Object]
        doc_content = ""
        if isinstance(raw_content, str):
            trimmed = raw_content.strip()
            if trimmed and trimmed != "[object Object]":
                doc_content = raw_content

        # Sanitize selected_text
        selected_text = ""
        if isinstance(raw_sel, str):
            trimmed = raw_sel.strip()
            if trimmed and trimmed != "[object Object]":
                selected_text = raw_sel

        # If document content is not in context snapshot, attempt reading it from local workspace
        if not doc_content and doc_path:
            try:
                candidate = os.path.normpath(os.path.join(self.workspace_dir, doc_path))
                if os.path.isfile(candidate) and candidate.startswith(self.workspace_dir):
                    with open(candidate, "r", encoding="utf-8", errors="replace") as f:
                        doc_content = f.read()
            except Exception:
                pass

        instructions = [
            "You are an expert AI programming and writing assistant integrated into CME (Collaborative Markdown Editor) via a local agent daemon.",
            f"You run directly on the user's workstation. Workspace root: {self.workspace_dir}",
            f"Allowed local tools: {', '.join(self.allowed_tools)}.",
            "",
            "### Active Document Context:",
            f"- Document Title: {doc_title or 'Untitled'}",
            f"- Document Path: {doc_path or 'Untitled.md'}",
        ]
        if doc_id:
            instructions.append(f"- Document ID: {doc_id}")

        if doc_content:
            instructions.append("\n### Active Document Content:\n```markdown\n" + doc_content + "\n```")

        line_start = context.get("line_start")
        if selected_text:
            loc_str = f" (starting at line {line_start})" if line_start else ""
            instructions.append(f"\n### Active Selection in Document{loc_str}:\n```markdown\n" + selected_text + "\n```")

        comments = context.get("comments", [])
        if comments and isinstance(comments, list):
            instructions.append("\n### Active Comments & Review Threads on Document:")
            for c in comments:
                if not isinstance(c, dict):
                    continue
                c_id = c.get("id", "")
                author = c.get("author", "User")
                status = c.get("status", "OPEN")
                quote = c.get("quote", "")
                body = c.get("content", "")
                replies = c.get("replies", [])
                item_str = f"- Comment ID `{c_id}` [{status}] by {author}: \"{body}\""
                if quote:
                    item_str += f" (anchored to text: \"{quote}\")"
                instructions.append(item_str)
                for r in replies:
                    if isinstance(r, dict):
                        instructions.append(f"  * Reply by {r.get('author', 'User')}: \"{r.get('content', '')}\"")

        suggestions = context.get("suggestions", [])
        if suggestions and isinstance(suggestions, list):
            instructions.append("\n### Active Inline Suggestions in Review System:")
            for s in suggestions:
                if not isinstance(s, dict):
                    continue
                s_id = s.get("id", "")
                author = s.get("author", "User")
                status = s.get("status", "PENDING")
                orig = s.get("original_text", "")
                sugg = s.get("suggested_text", "")
                instructions.append(f"- Suggestion ID `{s_id}` [{status}] by {author}: \"{orig}\" -> \"{sugg}\"")

        instructions.extend([
            "",
            "### Action Capabilities & How to Respond:",
            "Choose your response action based on what the user asks:",
            "",
            "1. DIRECT EDIT (change text directly with NO approval needed):",
            "   When the user asks you to fix, edit, change, rewrite, replace, or update text directly:",
            "   Output a structured ```action block with the exact original_text and replacement_text:",
            "   ```action",
            "   {",
            "     \"action\": \"direct_edit\",",
            "     \"original_text\": \"exact text currently in the document to replace (must match verbatim)\",",
            "     \"replacement_text\": \"new text to substitute in place of original_text\",",
            f"     \"diff\": \"--- a/{doc_path or 'document.md'}\\n+++ b/{doc_path or 'document.md'}\\n@@ -<line>,<count> +<line>,<count> @@\\n-old text\\n+new text\\n\"",
            "   }",
            "   ```",
            "   CME automatically applies this edit directly to the document without prompting the user for approval.",
            "",
            "2. ADD SUGGESTION (propose an inline suggestion into CME's Review System):",
            "   When the user asks you to propose, suggest, or draft an alternative phrasing:",
            "   ```action",
            "   {",
            "     \"action\": \"add_suggestion\",",
            "     \"original_text\": \"exact text in document to replace\",",
            "     \"suggested_text\": \"your recommended replacement text\"",
            "   }",
            "   ```",
            "",
            "3. REMOVE / REJECT / ACCEPT SUGGESTIONS:",
            "   When the user asks to remove, reject, or accept an existing suggestion from the list above:",
            "   ```action",
            "   {",
            "     \"action\": \"reject_suggestion\",",
            "     \"suggestion_id\": \"<id of the suggestion>\"",
            "   }",
            "   ```",
            "   (Or action=\"accept_suggestion\" to accept and apply the suggestion).",
            "",
            "4. ADD COMMENTS (post an anchored review comment):",
            "   When the user asks you to leave a note, ask a question, or comment on a specific section:",
            "   ```action",
            "   {",
            "     \"action\": \"add_comment\",",
            "     \"content\": \"your comment message\",",
            "     \"target_text\": \"exact text in document to anchor to\"",
            "   }",
            "   ```",
            "",
            "5. RESPOND TO COMMENTS (reply to an existing comment thread):",
            "   When the user asks you to answer or reply to an existing comment from the list above:",
            "   ```action",
            "   {",
            "     \"action\": \"reply_comment\",",
            "     \"comment_id\": \"<id of the comment to reply to>\",",
            "     \"content\": \"your reply text\"",
            "   }",
            "   ```",
            "",
            "6. GENERAL QUERIES & DIFF PROPOSALS:",
            "   If the user asks an exploratory question or explanation without modifying files, reply directly in standard Markdown.",
            "   If the user specifically asks for a diff to preview/review first (e.g. 'show diff', 'propose diff'), output a standard ```diff code block.",
            "Always include a concise, helpful explanation in Markdown alongside any action blocks you output."
        ])

        return "\n".join(instructions)

    async def _dispatch_actions_and_proposals(self, ws, dialog_id: str, context: Dict[str, Any], prompt: str, full_content: str):
        doc_id = context.get("document_id", "")
        actions_emitted = 0

        # 1. Parse any ```action or ```json:action blocks
        action_pattern = re.compile(r"```(?:action|json:action)\s*\n(.*?)\n```", re.DOTALL)
        for block in action_pattern.findall(full_content):
            try:
                parsed = json.loads(block.strip())
                items = parsed if isinstance(parsed, list) else [parsed]
                for item in items:
                    if isinstance(item, dict) and "action" in item:
                        action_type = item["action"]
                        await ws.send(json.dumps({
                            "type": "agent_action",
                            "dialog_id": dialog_id,
                            "document_id": doc_id,
                            "action": action_type,
                            "payload": item,
                        }))
                        actions_emitted += 1
                        print(f"[ACTION] Dispatched agent_action '{action_type}' for dialog {dialog_id[:8]}")
            except Exception as e:
                print(f"[AGENT] Failed to parse action block: {e}", file=sys.stderr)

        # 2. Check for unified diff if no direct_edit was explicitly emitted in action blocks
        diff_match = re.search(r"```(?:diff)?\s*\n((?:---[^\n]*\n\+\+\+[^\n]*\n)?@@.*?)```", full_content, re.DOTALL)
        if diff_match and actions_emitted == 0:
            diff_text = diff_match.group(1).strip()
            lower_prompt = prompt.lower()
            direct_triggers = ["no approval", "directly", "change", "fix", "replace", "correct", "update", "rewrite", "modify"]
            proposal_triggers = ["propose", "proposal", "preview", "review", "suggest a diff", "diff only"]
            is_direct = any(t in lower_prompt for t in direct_triggers) and not any(t in lower_prompt for t in proposal_triggers)

            if is_direct:
                await ws.send(json.dumps({
                    "type": "agent_action",
                    "dialog_id": dialog_id,
                    "document_id": doc_id,
                    "action": "direct_edit",
                    "payload": {
                        "action": "direct_edit",
                        "diff": diff_text,
                    },
                }))
                print(f"[ACTION] Dispatched direct_edit (no approval needed) for dialog {dialog_id[:8]}")
            else:
                await ws.send(json.dumps({
                    "type": "diff_proposal",
                    "dialog_id": dialog_id,
                    "document_id": doc_id,
                    "diff": diff_text,
                }))
                print(f"[ACTION] Dispatched diff_proposal for dialog {dialog_id[:8]}")

    async def handle_prompt_request(self, ws, request: Dict[str, Any]):
        dialog_id = request.get("dialog_id", "")
        prompt = request.get("prompt", "")
        history = request.get("dialog_history", [])
        context = request.get("context", {})

        print(f"\n[PROMPT] Received request for dialog {dialog_id[:8]}...: '{prompt[:60]}'")

        active_prov = self._detect_provider()

        # Emit tool notice if context mentions local repo or files
        if "git" in self.allowed_tools and any(w in prompt.lower() for w in ["git", "commit", "branch", "diff", "log"]):
            await ws.send(json.dumps({
                "type": "tool_activity",
                "dialog_id": dialog_id,
                "tool": "local_git",
                "status": "inspecting repository",
            }))
            await asyncio.sleep(0.3)

        if active_prov == "gemini":
            await self._stream_gemini(ws, dialog_id, prompt, history, context)
        elif active_prov == "ollama":
            await self._stream_ollama(ws, dialog_id, prompt, history, context)
        elif active_prov in ("openai", "custom") or self.api_base:
            await self._stream_openai_compatible(ws, dialog_id, prompt, history, context)
        elif active_prov == "anthropic":
            await self._stream_anthropic(ws, dialog_id, prompt, history, context)
        elif active_prov == "command":
            await self._stream_command(ws, dialog_id, prompt, history, context)
        else:
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_gemini(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        api_key = self._get_api_key("gemini")
        if not api_key:
            print("[WARN] No GEMINI_API_KEY found. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)
            return

        model_name = self.model or "gemini-1.5-flash"
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:streamGenerateContent?key={api_key}&alt=sse"

        # Build contents from history and context
        contents = []
        for h in history:
            role = "user" if h.get("role") == "user" else "model"
            contents.append({"role": role, "parts": [{"text": h.get("content", "")}]})

        user_text = prompt
        selected_text = context.get("selected_text", "")
        doc_title = context.get("document_title", "")
        if selected_text:
            user_text = f"Regarding document '{doc_title}':\n```markdown\n{selected_text}\n```\n\nPrompt: {prompt}"

        contents.append({"role": "user", "parts": [{"text": user_text}]})

        system_instructions = self._build_system_instructions(context)
        payload = {
            "contents": contents,
            "system_instruction": {
                "parts": [{"text": system_instructions}]
            },
            "generationConfig": {
                "temperature": 0.7,
            }
        }

        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=60.0) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if decoded.startswith("data: "):
                        data_str = decoded[6:].strip()
                        if not data_str:
                            continue
                        try:
                            chunk = json.loads(data_str)
                            for cand in chunk.get("candidates", []):
                                for part in cand.get("content", {}).get("parts", []):
                                    text = part.get("text", "")
                                    if text:
                                        full_content += text
                                        await ws.send(json.dumps({
                                            "type": "token_stream",
                                            "dialog_id": dialog_id,
                                            "delta": text,
                                        }))
                        except Exception:
                            pass

            # Dispatch any structured actions (direct edit, suggestions, comments) or diff proposals
            await self._dispatch_actions_and_proposals(ws, dialog_id, context, prompt, full_content)

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
            print(f"[PROMPT] Completed Gemini response ({len(full_content)} chars)")
        except urllib.error.HTTPError as e:
            err_body = ""
            try:
                err_body = e.read().decode("utf-8", errors="replace")
                err_json = json.loads(err_body)
                err_msg = err_json.get("error", {}).get("message", err_body)
            except Exception:
                err_msg = e.reason or str(e)
            print(f"[AGENT] Gemini API Error (HTTP {e.code}): {err_msg}", file=sys.stderr)
            error_text = f"**Google Gemini API Error (HTTP {e.code}):** {err_msg}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))
        except Exception as e:
            print(f"[AGENT] Gemini streaming error: {e}", file=sys.stderr)
            error_text = f"**Google Gemini Error:** {e}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))

    async def _stream_openai_compatible(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        api_base = self.api_base or "https://api.openai.com/v1"
        api_key = self._get_api_key("openai") or "none"
        model_name = self.model or "gpt-4o"

        url = f"{api_base.rstrip('/')}/chat/completions"

        system_instructions = self._build_system_instructions(context)
        messages = [{"role": "system", "content": system_instructions}]
        for h in history:
            messages.append({"role": h.get("role", "user"), "content": h.get("content", "")})

        user_text = prompt
        selected_text = context.get("selected_text", "")
        doc_title = context.get("document_title", "")
        if selected_text:
            user_text = f"Context from '{doc_title}':\n```markdown\n{selected_text}\n```\n\n{prompt}"

        messages.append({"role": "user", "content": user_text})

        payload = {
            "model": model_name,
            "messages": messages,
            "stream": True,
        }

        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {api_key}",
                },
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=60.0) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if decoded.startswith("data: "):
                        data_str = decoded[6:].strip()
                        if data_str == "[DONE]":
                            break
                        try:
                            chunk = json.loads(data_str)
                            delta = chunk.get("choices", [{}])[0].get("delta", {}).get("content", "")
                            if delta:
                                full_content += delta
                                await ws.send(json.dumps({
                                    "type": "token_stream",
                                    "dialog_id": dialog_id,
                                    "delta": delta,
                                }))
                        except Exception:
                            pass

            # Dispatch any structured actions (direct edit, suggestions, comments) or diff proposals
            await self._dispatch_actions_and_proposals(ws, dialog_id, context, prompt, full_content)

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except urllib.error.HTTPError as e:
            err_body = ""
            try:
                err_body = e.read().decode("utf-8", errors="replace")
                err_json = json.loads(err_body)
                err_msg = err_json.get("error", {}).get("message", err_body)
            except Exception:
                err_msg = e.reason or str(e)
            print(f"[AGENT] OpenAI-compatible API Error (HTTP {e.code}): {err_msg}", file=sys.stderr)
            error_text = f"**OpenAI API Error (HTTP {e.code}):** {err_msg}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))
        except Exception as e:
            print(f"[AGENT] OpenAI-compatible stream error: {e}", file=sys.stderr)
            error_text = f"**OpenAI-Compatible Error:** {e}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))

    async def _stream_ollama(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        try:
            system_instructions = self._build_system_instructions(context)
            payload = {
                "model": self.model or "llama3.1",
                "prompt": prompt,
                "system": system_instructions,
                "stream": True,
            }
            req = urllib.request.Request(
                f"{self.ollama_host}/api/generate",
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=45.0) as resp:
                for line in resp:
                    if not line:
                        continue
                    try:
                        chunk = json.loads(line.decode("utf-8"))
                        token = chunk.get("response", "")
                        if token:
                            full_content += token
                            await ws.send(json.dumps({
                                "type": "token_stream",
                                "dialog_id": dialog_id,
                                "delta": token,
                            }))
                        if chunk.get("done", False):
                            break
                    except Exception:
                        pass

            # Dispatch any structured actions (direct edit, suggestions, comments) or diff proposals
            await self._dispatch_actions_and_proposals(ws, dialog_id, context, prompt, full_content)

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except Exception as e:
            print(f"[AGENT] Ollama generation failed: {e}", file=sys.stderr)
            error_text = f"**Ollama Error:** {e}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))

    async def _stream_anthropic(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        api_key = self._get_api_key("anthropic")
        if not api_key:
            await self._stream_echo(ws, dialog_id, prompt, history, context)
            return

        url = "https://api.anthropic.com/v1/messages"
        system_instructions = self._build_system_instructions(context)
        messages = []
        for h in history:
            messages.append({"role": h.get("role", "user"), "content": h.get("content", "")})
        messages.append({"role": "user", "content": prompt})

        payload = {
            "model": self.model or "claude-3-5-sonnet-20241022",
            "system": system_instructions,
            "messages": messages,
            "max_tokens": 4096,
            "stream": True,
        }

        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={
                    "Content-Type": "application/json",
                    "x-api-key": api_key,
                    "anthropic-version": "2023-06-01",
                },
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=60.0) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if decoded.startswith("data: "):
                        data_str = decoded[6:].strip()
                        try:
                            chunk = json.loads(data_str)
                            if chunk.get("type") == "content_block_delta":
                                delta = chunk.get("delta", {}).get("text", "")
                                if delta:
                                    full_content += delta
                                    await ws.send(json.dumps({
                                        "type": "token_stream",
                                        "dialog_id": dialog_id,
                                        "delta": delta,
                                    }))
                        except Exception:
                            pass

            # Dispatch any structured actions (direct edit, suggestions, comments) or diff proposals
            await self._dispatch_actions_and_proposals(ws, dialog_id, context, prompt, full_content)

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except urllib.error.HTTPError as e:
            err_body = ""
            try:
                err_body = e.read().decode("utf-8", errors="replace")
                err_json = json.loads(err_body)
                err_msg = err_json.get("error", {}).get("message", err_body)
            except Exception:
                err_msg = e.reason or str(e)
            print(f"[AGENT] Anthropic API Error (HTTP {e.code}): {err_msg}", file=sys.stderr)
            error_text = f"**Anthropic API Error (HTTP {e.code}):** {err_msg}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))
        except Exception as e:
            print(f"[AGENT] Anthropic streaming error: {e}", file=sys.stderr)
            error_text = f"**Anthropic Error:** {e}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))

    async def _stream_echo(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        doc_path = context.get("document_path") or "document.md"
        doc_title = context.get("document_title") or context.get("document_id") or ""
        selected_text = context.get("selected_text", "")

        response_chunks = [
            f"Hello! I am your local AI agent daemon (`{self.agent_name}`).\n\n",
            f"I received your request: \"{prompt}\".\n\n",
        ]

        if doc_title or doc_path:
            response_chunks.append(f"Working on document `{doc_title or doc_path}` (`{doc_path}`).\n\n")

        if selected_text:
            response_chunks.append(f"Regarding your selected document context:\n> {selected_text.strip()}\n\n")

        response_chunks.append("Running locally on your workstation, I have direct access to your local files and CLI tools without exposing inbound network ports.\n")

        full_content = ""
        for chunk in response_chunks:
            full_content += chunk
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": chunk,
            }))
            await asyncio.sleep(0.04)

        lower_p = prompt.lower()
        action_markdown = ""

        if any(w in lower_p for w in ["suggest", "suggestion", "propose alternative"]):
            orig = selected_text.strip() if selected_text else "Draft section with errors"
            sugg = f"Improved: {orig}" if orig != "Draft section with errors" else "Corrected section: verified by local agent"
            action_markdown = (
                f"\nI have proposed an inline suggestion into the review system:\n\n"
                f"```action\n"
                f"{{\n"
                f'  "action": "add_suggestion",\n'
                f'  "original_text": {json.dumps(orig)},\n'
                f'  "suggested_text": {json.dumps(sugg)}\n'
                f"}}\n"
                f"```\n"
            )
        elif any(w in lower_p for w in ["reject", "remove suggestion", "delete suggestion"]):
            suggestions = context.get("suggestions", [])
            sugg_id = suggestions[0].get("id") if (suggestions and isinstance(suggestions[0], dict)) else "sugg-demo-1"
            action_markdown = (
                f"\nI have rejected the suggestion as requested:\n\n"
                f"```action\n"
                f"{{\n"
                f'  "action": "reject_suggestion",\n'
                f'  "suggestion_id": {json.dumps(sugg_id)}\n'
                f"}}\n"
                f"```\n"
            )
        elif any(w in lower_p for w in ["accept suggestion"]):
            suggestions = context.get("suggestions", [])
            sugg_id = suggestions[0].get("id") if (suggestions and isinstance(suggestions[0], dict)) else "sugg-demo-1"
            action_markdown = (
                f"\nI have accepted and applied the suggestion:\n\n"
                f"```action\n"
                f"{{\n"
                f'  "action": "accept_suggestion",\n'
                f'  "suggestion_id": {json.dumps(sugg_id)}\n'
                f"}}\n"
                f"```\n"
            )
        elif any(w in lower_p for w in ["reply", "respond to comment", "answer comment"]):
            comments = context.get("comments", [])
            comm_id = comments[0].get("id") if (comments and isinstance(comments[0], dict)) else "comm-demo-1"
            reply_msg = "Thanks for the feedback. I have verified this change meets the specifications."
            action_markdown = (
                f"\nI have replied to the comment thread:\n\n"
                f"```action\n"
                f"{{\n"
                f'  "action": "reply_comment",\n'
                f'  "comment_id": {json.dumps(comm_id)},\n'
                f'  "content": {json.dumps(reply_msg)}\n'
                f"}}\n"
                f"```\n"
            )
        elif any(w in lower_p for w in ["add comment", "comment on", "leave a comment", "leave a note"]):
            target = selected_text.strip() if selected_text else "Draft section with errors"
            comment_msg = "Please consider reviewing this section for clarity and adherence to the style guide."
            action_markdown = (
                f"\nI have added a review comment:\n\n"
                f"```action\n"
                f"{{\n"
                f'  "action": "add_comment",\n'
                f'  "content": {json.dumps(comment_msg)},\n'
                f'  "target_text": {json.dumps(target)}\n'
                f"}}\n"
                f"```\n"
            )
        elif any(w in lower_p for w in ["propose", "proposal", "preview diff", "show diff"]):
            diff_text = f"--- a/{doc_path}\n+++ b/{doc_path}\n@@ -1,3 +1,3 @@\n-Draft section with errors\n+Proposed improvement: preview before applying\n"
            action_markdown = (
                f"\nHere is a proposed diff for your review:\n\n"
                f"```diff\n{diff_text}```\n"
            )
        elif any(w in lower_p for w in ["direct", "change", "replace", "fix", "edit", "no approval", "correct", "refactor"]):
            orig = selected_text.strip() if selected_text else "Draft section with errors"
            rep = "Corrected section: verified by local agent"
            line_start = context.get("line_start", 1) or 1
            orig_lines = orig.split("\n")
            rep_lines = rep.split("\n")
            diff_text = (
                f"--- a/{doc_path}\n"
                f"+++ b/{doc_path}\n"
                f"@@ -{line_start},{len(orig_lines)} +{line_start},{len(rep_lines)} @@\n"
                + "\n".join(f"-{l}" for l in orig_lines) + "\n"
                + "\n".join(f"+{l}" for l in rep_lines) + "\n"
            )
            action_markdown = (
                f"\nI have applied the edits directly to your document (no approval needed):\n\n"
                f"```action\n"
                f"{{\n"
                f'  "action": "direct_edit",\n'
                f'  "original_text": {json.dumps(orig)},\n'
                f'  "replacement_text": {json.dumps(rep)},\n'
                f'  "diff": {json.dumps(diff_text)}\n'
                f"}}\n"
                f"```\n"
            )

        if action_markdown:
            full_content += action_markdown
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": action_markdown,
            }))

        # Dispatch any structured actions or diff proposals
        await self._dispatch_actions_and_proposals(ws, dialog_id, context, prompt, full_content)

        await ws.send(json.dumps({
            "type": "prompt_complete",
            "dialog_id": dialog_id,
            "content": full_content,
        }))
        print(f"[PROMPT] Completed response for dialog {dialog_id[:8]}")

    async def _stream_command(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        cmd_template = self.command or "claude -p --output-format stream-json --verbose"

        # Build full prompt containing system instructions, context, history, and user request
        system_inst = self._build_system_instructions(context)
        prompt_parts = []
        if system_inst:
            prompt_parts.append(system_inst)
            prompt_parts.append("\n---\n")

        if history:
            prompt_parts.append("### Conversation History:\n")
            for msg in history:
                sender = msg.get("sender_type", msg.get("role", "user")).upper()
                content = msg.get("content", "")
                if content:
                    prompt_parts.append(f"{sender}: {content}\n")
            prompt_parts.append("\n---\n")

        prompt_parts.append(f"User Request:\n{prompt}\n")
        full_input = "\n".join(prompt_parts)

        # Check if template has placeholder {prompt}
        has_prompt_slot = "{prompt}" in cmd_template
        if has_prompt_slot:
            cmd_exec = cmd_template.replace("{prompt}", shlex.quote(full_input))
            stdin_data = None
        else:
            cmd_exec = cmd_template
            stdin_data = full_input.encode("utf-8")

        print(f"[AGENT] Spawning CLI agent command: {cmd_template[:100]}...")

        env = os.environ.copy()
        env["PYTHONUNBUFFERED"] = "1"
        if "NO_COLOR" not in env:
            env["NO_COLOR"] = "1"

        try:
            proc = await asyncio.create_subprocess_shell(
                cmd_exec,
                stdin=asyncio.subprocess.PIPE if stdin_data is not None else None,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                cwd=self.workspace_dir,
                env=env,
            )

            if stdin_data is not None:
                try:
                    proc.stdin.write(stdin_data)
                    await proc.stdin.drain()
                    proc.stdin.close()
                except Exception as e:
                    print(f"[AGENT] Error writing to command stdin: {e}", file=sys.stderr)

            full_content = ""
            streamed_chunks = False

            while True:
                line_bytes = await proc.stdout.readline()
                if not line_bytes:
                    break
                line = line_bytes.decode("utf-8", errors="replace").rstrip("\r\n")
                if not line.strip():
                    continue

                delta_text = ""
                try:
                    evt = json.loads(line)
                    if isinstance(evt, dict):
                        evt_type = evt.get("type", "")

                        # 1. Claude stream_event (with text_delta, thinking_delta, etc.)
                        if evt_type == "stream_event":
                            inner = evt.get("event", {})
                            inner_type = inner.get("type", "")
                            if inner_type == "content_block_delta":
                                inner_delta = inner.get("delta", {})
                                delta_text = inner_delta.get("text", "")
                                if not delta_text and "thinking" in inner_delta:
                                    await ws.send(json.dumps({
                                        "type": "tool_activity",
                                        "dialog_id": dialog_id,
                                        "tool": "thinking",
                                        "status": inner_delta.get("thinking", "")[:80],
                                    }))

                        # 2. Direct content_block_delta (SSE/Messages API style)
                        elif evt_type == "content_block_delta":
                            delta_obj = evt.get("delta", {})
                            delta_text = delta_obj.get("text", "")

                        # 3. Tool use / tool execution event
                        elif evt_type in ("tool_use", "tool_call"):
                            tool_name = evt.get("name") or evt.get("tool") or "cli_tool"
                            await ws.send(json.dumps({
                                "type": "tool_activity",
                                "dialog_id": dialog_id,
                                "tool": tool_name,
                                "status": "executing",
                            }))

                        # 4. Assistant message chunk or completion
                        elif evt_type == "assistant":
                            if not streamed_chunks:
                                msg = evt.get("message", {})
                                content = msg.get("content", [])
                                if isinstance(content, list):
                                    texts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
                                    delta_text = "".join(texts)
                                elif isinstance(content, str):
                                    delta_text = content
                                elif "delta" in evt:
                                    delta_text = evt.get("delta", {}).get("text", "")

                        # 5. Generic delta or chunk or text
                        elif "delta" in evt:
                            d = evt["delta"]
                            delta_text = d.get("text", "") if isinstance(d, dict) else str(d)
                        elif "chunk" in evt:
                            delta_text = str(evt["chunk"])
                        elif "text" in evt and not streamed_chunks:
                            delta_text = str(evt["text"])
                        elif evt_type == "result" and not streamed_chunks:
                            res = evt.get("result") or evt.get("output")
                            if isinstance(res, str):
                                delta_text = res

                except json.JSONDecodeError:
                    # Plain text fallback from CLI tool
                    delta_text = line + "\n"

                if delta_text:
                    full_content += delta_text
                    streamed_chunks = True
                    await ws.send(json.dumps({
                        "type": "token_stream",
                        "dialog_id": dialog_id,
                        "delta": delta_text,
                    }))

            stderr_bytes = await proc.stderr.read()
            await proc.wait()

            if proc.returncode != 0:
                err_msg = stderr_bytes.decode("utf-8", errors="replace").strip()
                print(f"[AGENT] Command agent exited with error code {proc.returncode}: {err_msg}", file=sys.stderr)
                if not full_content:
                    full_content = f"**Error running command agent (exit code {proc.returncode}):**\n```\n{err_msg or 'Unknown error'}\n```"
                    await ws.send(json.dumps({
                        "type": "token_stream",
                        "dialog_id": dialog_id,
                        "delta": full_content,
                    }))

            # Dispatch any structured actions (direct edit, suggestions, comments) or diff proposals
            await self._dispatch_actions_and_proposals(ws, dialog_id, context, prompt, full_content)

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
            print(f"[PROMPT] Completed response for dialog {dialog_id[:8]}")

        except Exception as e:
            print(f"[AGENT] Command streaming error: {e}", file=sys.stderr)
            error_text = f"**Command Execution Error:** {e}"
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": f"\n\n{error_text}\n",
            }))
            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": error_text,
            }))


def main():
    parser = argparse.ArgumentParser(
        description="CME Local Agent CLI Daemon - Bridges Gemini, Ollama, Anthropic, OpenAI, CLI tools & local workstation with CME."
    )
    parser.add_argument(
        "--server", "-s",
        type=str,
        default="http://localhost:18080",
        help="CME Server URL (e.g., http://localhost:18080 or https://editor.example.com)"
    )
    parser.add_argument(
        "--token", "-t",
        type=str,
        default=None,
        help="Cryptographic agent pairing token generated in CME UI (optional if --auth-command or delegated --header is used)"
    )
    parser.add_argument(
        "--auth-command",
        type=str,
        default=None,
        help="Shell command executed before connect and on each reconnect to obtain a fresh agent token from stdout"
    )
    parser.add_argument(
        "--header", "-H",
        dest="headers",
        action="append",
        default=[],
        help="Custom HTTP/WebSocket header to send on connect (e.g. 'X-Remote-User: alice' or 'Authorization: Bearer ...'). Can be repeated."
    )
    parser.add_argument(
        "--header-cmd", "--header-command",
        dest="header_cmd",
        type=str,
        default=None,
        help="Shell command executed before connect and on each reconnect to obtain HTTP headers from stdout (useful for time-bound auth tokens or rotated headers)"
    )
    parser.add_argument(
        "--name", "-n",
        type=str,
        default=f"{socket.gethostname()}-agent",
        help="Human-readable name identifying this agent in CME"
    )
    parser.add_argument(
        "--provider", "-p",
        type=str,
        default="auto",
        help="Inference provider: gemini, ollama, anthropic, openai, command, custom, echo (default: auto)"
    )
    parser.add_argument(
        "--cmd", "--command",
        dest="command",
        type=str,
        default=None,
        help="Shell command for the command-line agent (default: 'claude -p --output-format stream-json --verbose'). Used when --provider command is selected."
    )
    parser.add_argument(
        "--model", "-m",
        type=str,
        default=None,
        help="Model identifier (e.g., gemini-1.5-flash, llama3.1, claude-3-5-sonnet, gpt-4o)"
    )
    parser.add_argument(
        "--api-key", "-k",
        type=str,
        default=None,
        help="API key for Gemini, Anthropic, OpenAI, or custom endpoint (can also use env vars)"
    )
    parser.add_argument(
        "--api-base", "--base-url",
        type=str,
        default=None,
        help="Custom OpenAI-compatible base URL (e.g. http://localhost:8000/v1 or https://api.groq.com/openai/v1)"
    )
    parser.add_argument(
        "--ollama-host",
        type=str,
        default="http://localhost:11434",
        help="Local Ollama service URL (default: http://localhost:11434)"
    )
    parser.add_argument(
        "--allow-tools",
        type=str,
        default="git,grep,filesystem",
        help="Comma-separated local workstation tools allowed"
    )
    parser.add_argument(
        "--workspace",
        type=str,
        default=None,
        help="Root workspace path for local tool executions (default: cwd)"
    )

    args = parser.parse_args()

    # Validate that at least one form of authentication is provided
    if not args.token and not args.auth_command and not args.headers and not args.header_cmd:
        parser.error("One of --token, --auth-command, --header-cmd, or --header (for delegated auth) is required.")

    tools = [t.strip() for t in args.allow_tools.split(",") if t.strip()]

    agent = CMEAgentDaemon(
        server_url=args.server,
        token=args.token,
        agent_name=args.name,
        provider=args.provider,
        model=args.model,
        api_key=args.api_key,
        api_base=args.api_base,
        ollama_host=args.ollama_host,
        allowed_tools=tools,
        workspace_dir=args.workspace,
        auth_command=args.auth_command,
        headers=args.headers,
        header_cmd=args.header_cmd,
        command=args.command,
    )

    agent.validate_provider()

    try:
        asyncio.run(agent.run())
    except KeyboardInterrupt:
        print("\n[AGENT] Stopped by user.")


if __name__ == "__main__":
    main()
