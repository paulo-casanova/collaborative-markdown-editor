#!/usr/bin/env python3
"""
CME Local Agent CLI Daemon (cme-agent)
Bridges local workstation resources (Ollama, Anthropic, OpenAI, local tools, git, shell)
with Collaborative Markdown Editor (CME) dialog sessions over an outbound WebSocket tunnel.
"""

import sys
import os
import json
import time
import socket
import argparse
import asyncio
import re
import urllib.request
import urllib.error
from typing import Optional, Dict, Any, List

try:
    import websockets
except ImportError:
    print("Error: 'websockets' package is required. Install via: pip install websockets", file=sys.stderr)
    sys.exit(1)


class CMEAgentDaemon:
    def __init__(
        self,
        server_url: str,
        token: str,
        agent_name: str,
        provider: str = "auto",
        model: str = "llama3.1",
        ollama_host: str = "http://localhost:11434",
        allowed_tools: Optional[List[str]] = None,
        workspace_dir: Optional[str] = None,
    ):
        self.server_url = server_url.rstrip("/")
        self.token = token
        self.agent_name = agent_name
        self.provider = provider
        self.model = model
        self.ollama_host = ollama_host.rstrip("/")
        self.allowed_tools = set(allowed_tools or ["git", "grep", "filesystem"])
        self.workspace_dir = os.path.abspath(workspace_dir or os.getcwd())
        self.running = True

    def _detect_provider(self) -> str:
        if self.provider != "auto":
            return self.provider

        # Check if Ollama is running locally
        try:
            req = urllib.request.Request(f"{self.ollama_host}/api/tags", method="GET")
            with urllib.request.urlopen(req, timeout=1.0) as resp:
                if resp.status == 200:
                    return "ollama"
        except Exception:
            pass

        # Check environment variables
        if os.environ.get("ANTHROPIC_API_KEY"):
            return "anthropic"
        if os.environ.get("OPENAI_API_KEY"):
            return "openai"

        return "echo"

    async def run(self):
        ws_base = self.server_url.replace("http://", "ws://").replace("https://", "wss://")
        ws_endpoint = f"{ws_base}/api/v1/agents/ws?token={urllib.parse.quote(self.token)}&name={urllib.parse.quote(self.agent_name)}"

        print("=" * 60)
        print("  CME Local Agent Daemon (cme-agent)")
        print(f"  Name:      {self.agent_name}")
        print(f"  Server:    {self.server_url}")
        print(f"  Workspace: {self.workspace_dir}")
        print(f"  Tools:     {', '.join(sorted(self.allowed_tools))}")
        active_prov = self._detect_provider()
        print(f"  Provider:  {active_prov} ({self.model})")
        print("=" * 60)

        backoff = 1.0
        while self.running:
            try:
                print(f"\n[AGENT] Connecting outbound to CME gateway at {self.server_url}...")
                async with websockets.connect(
                    ws_endpoint,
                    ping_interval=20,
                    ping_timeout=20,
                    max_size=16 * 1024 * 1024,
                ) as ws:
                    backoff = 1.0
                    print(f"[AGENT] Connection established. Listening for prompt requests...")

                    async for message in ws:
                        try:
                            data = json.loads(message)
                            msg_type = data.get("type", "")

                            if msg_type == "agent_ack":
                                print(f"[AGENT] Handshake acknowledged by server: version={data.get('server_version')}")
                            elif msg_type == "ping":
                                await ws.send(json.dumps({"type": "pong"}))
                            elif msg_type == "prompt_request":
                                asyncio.create_task(self.handle_prompt_request(ws, data))
                            else:
                                print(f"[AGENT] Received unhandled frame type: {msg_type}")
                        except Exception as e:
                            print(f"[AGENT] Error parsing frame: {e}", file=sys.stderr)

            except (websockets.exceptions.ConnectionClosedError, ConnectionRefusedError, OSError) as e:
                if not self.running:
                    break
                print(f"[AGENT] Connection lost: {e}. Reconnecting in {backoff:.1f}s...")
                await asyncio.sleep(backoff)
                backoff = min(backoff * 1.5, 30.0)
            except Exception as e:
                print(f"[AGENT] Unexpected error: {e}", file=sys.stderr)
                await asyncio.sleep(5.0)

    async def handle_prompt_request(self, ws, request: Dict[str, Any]):
        dialog_id = request.get("dialog_id", "")
        prompt = request.get("prompt", "")
        history = request.get("dialog_history", [])
        context = request.get("context", {})

        print(f"\n[PROMPT] Received request for dialog {dialog_id[:8]}...: '{prompt[:60]}'")

        active_prov = self._detect_provider()

        # Emit tool notice if context mentions local repo or files
        if "git" in self.allowed_tools and ("git" in prompt.lower() or "commit" in prompt.lower() or "branch" in prompt.lower()):
            await ws.send(json.dumps({
                "type": "tool_activity",
                "dialog_id": dialog_id,
                "tool": "local_git",
                "status": "inspecting commit history",
            }))
            await asyncio.sleep(0.3)

        if active_prov == "ollama":
            await self._stream_ollama(ws, dialog_id, prompt, history, context)
        elif active_prov == "anthropic":
            await self._stream_anthropic(ws, dialog_id, prompt, history, context)
        elif active_prov == "openai":
            await self._stream_openai(ws, dialog_id, prompt, history, context)
        else:
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_echo(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        doc_info = context.get("document_title") or context.get("document_id") or ""
        selected_text = context.get("selected_text", "")

        response_chunks = [
            f"Hello! I am your local AI agent daemon (`{self.agent_name}`).\n\n",
            f"I received your question: \"{prompt}\".\n\n",
        ]

        if selected_text:
            response_chunks.append(f"Regarding your selected document text:\n> {selected_text.strip()}\n\n")

        response_chunks.append("Running locally on your workstation, I have direct access to your local files and CLI tools without exposing inbound network ports.\n")

        full_content = ""
        for chunk in response_chunks:
            full_content += chunk
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": chunk,
            }))
            await asyncio.sleep(0.05)

        # If user asked for edit, refactor, or diff, generate a sample diff proposal
        if any(w in prompt.lower() for w in ["refactor", "diff", "edit", "change", "replace", "fix"]):
            diff_text = "--- a/document.md\n+++ b/document.md\n@@ -1,3 +1,3 @@\n-Draft section\n+Refactored section: verified by local agent\n"
            await ws.send(json.dumps({
                "type": "diff_proposal",
                "dialog_id": dialog_id,
                "document_id": context.get("document_id", ""),
                "diff": diff_text,
            }))

        await ws.send(json.dumps({
            "type": "prompt_complete",
            "dialog_id": dialog_id,
            "content": full_content,
        }))
        print(f"[PROMPT] Completed response for dialog {dialog_id[:8]}")

    async def _stream_ollama(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        try:
            payload = {
                "model": self.model,
                "prompt": prompt,
                "stream": True,
            }
            req = urllib.request.Request(
                f"{self.ollama_host}/api/generate",
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=30.0) as resp:
                for line in resp:
                    if not line:
                        continue
                    try:
                        chunk = json.loads(line.decode("utf-8"))
                        token = chunk.get("response", "")
                        if token:
                            full_content += token
                            await ws.send(json.dumps({
                                "type": "token_stream",
                                "dialog_id": dialog_id,
                                "delta": token,
                            }))
                        if chunk.get("done", False):
                            break
                    except Exception:
                        pass

            # Check for diff blocks in generated markdown
            diff_match = re.search(r"```diff\n(.*?)```", full_content, re.DOTALL)
            if diff_match:
                await ws.send(json.dumps({
                    "type": "diff_proposal",
                    "dialog_id": dialog_id,
                    "document_id": context.get("document_id", ""),
                    "diff": diff_match.group(1).strip(),
                }))

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except Exception as e:
            print(f"[AGENT] Ollama generation failed: {e}. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_anthropic(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        # Implementation fallback if anthropic library is not installed
        await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_openai(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        # Implementation fallback if openai library is not installed
        await self._stream_echo(ws, dialog_id, prompt, history, context)


def main():
    parser = argparse.ArgumentParser(
        description="CME Local Agent CLI Daemon - Bridges local LLMs & workstation tools with CME."
    )
    parser.add_argument(
        "--server", "-s",
        type=str,
        default="http://localhost:18080",
        help="CME Server URL (e.g., http://localhost:18080 or https://editor.example.com)"
    )
    parser.add_argument(
        "--token", "-t",
        type=str,
        required=True,
        help="Cryptographic agent pairing token generated in CME UI"
    )
    parser.add_argument(
        "--name", "-n",
        type=str,
        default=f"{socket.gethostname()}-agent",
        help="Human-readable name identifying this agent in CME"
    )
    parser.add_argument(
        "--provider", "-p",
        choices=["auto", "ollama", "anthropic", "openai", "echo"],
        default="auto",
        help="Inference engine provider (default: auto)"
    )
    parser.add_argument(
        "--model", "-m",
        type=str,
        default="llama3.1",
        help="Model identifier (e.g., llama3.1, mistral, claude-3-5-sonnet)"
    )
    parser.add_argument(
        "--ollama-host",
        type=str,
        default="http://localhost:11434",
        help="Local Ollama service URL (default: http://localhost:11434)"
    )
    parser.add_argument(
        "--allow-tools",
        type=str,
        default="git,grep,filesystem",
        help="Comma-separated local workstation tools allowed"
    )
    parser.add_argument(
        "--workspace",
        type=str,
        default=None,
        help="Root workspace path for local tool executions (default: cwd)"
    )

    args = parser.parse_args()

    tools = [t.strip() for t in args.allow_tools.split(",") if t.strip()]

    agent = CMEAgentDaemon(
        server_url=args.server,
        token=args.token,
        agent_name=args.name,
        provider=args.provider,
        model=args.model,
        ollama_host=args.ollama_host,
        allowed_tools=tools,
        workspace_dir=args.workspace,
    )

    try:
        asyncio.run(agent.run())
    except KeyboardInterrupt:
        print("\n[AGENT] Stopped by user.")


if __name__ == "__main__":
    main()
