#!/usr/bin/env python3
"""
CME Local Agent CLI Daemon (cme-agent)
Bridges local workstation resources (Gemini, Ollama, Anthropic, OpenAI, custom LLMs, git, shell)
with Collaborative Markdown Editor (CME) dialog sessions over an outbound WebSocket tunnel.
"""

import sys
import os
import json
import time
import socket
import argparse
import asyncio
import re
import urllib.request
import urllib.parse
import urllib.error
from typing import Optional, Dict, Any, List

try:
    import websockets
except ImportError:
    print("Error: 'websockets' package is required. Install via: pip install websockets", file=sys.stderr)
    sys.exit(1)


class CMEAgentDaemon:
    def __init__(
        self,
        server_url: str,
        token: str,
        agent_name: str,
        provider: str = "auto",
        model: Optional[str] = None,
        api_key: Optional[str] = None,
        api_base: Optional[str] = None,
        ollama_host: str = "http://localhost:11434",
        allowed_tools: Optional[List[str]] = None,
        workspace_dir: Optional[str] = None,
    ):
        self.server_url = server_url.rstrip("/")
        self.token = token
        self.agent_name = agent_name
        self.provider = provider.lower()
        self.model = model
        self.api_key = api_key
        self.api_base = api_base
        self.ollama_host = ollama_host.rstrip("/")
        self.allowed_tools = set(allowed_tools or ["git", "grep", "filesystem"])
        self.workspace_dir = os.path.abspath(workspace_dir or os.getcwd())
        self.running = True

        # Default model selection based on provider
        if not self.model:
            if self.provider == "gemini":
                self.model = "gemini-1.5-flash"
            elif self.provider == "anthropic":
                self.model = "claude-3-5-sonnet-20241022"
            elif self.provider == "openai":
                self.model = "gpt-4o"
            else:
                self.model = "llama3.1"

    def _detect_provider(self) -> str:
        if self.provider != "auto":
            return self.provider

        # 1. Check Google Gemini
        if self.api_key or os.environ.get("GEMINI_API_KEY"):
            return "gemini"

        # 2. Check Anthropic
        if os.environ.get("ANTHROPIC_API_KEY"):
            return "anthropic"

        # 3. Check OpenAI
        if os.environ.get("OPENAI_API_KEY"):
            return "openai"

        # 4. Check if Ollama is running locally
        try:
            req = urllib.request.Request(f"{self.ollama_host}/api/tags", method="GET")
            with urllib.request.urlopen(req, timeout=1.0) as resp:
                if resp.status == 200:
                    return "ollama"
        except Exception:
            pass

        return "echo"

    def _get_api_key(self, provider: str) -> Optional[str]:
        if self.api_key:
            return self.api_key
        if provider == "gemini":
            return os.environ.get("GEMINI_API_KEY")
        if provider == "anthropic":
            return os.environ.get("ANTHROPIC_API_KEY")
        if provider == "openai":
            return os.environ.get("OPENAI_API_KEY")
        return None

    async def run(self):
        ws_base = self.server_url.replace("http://", "ws://").replace("https://", "wss://")
        ws_endpoint = f"{ws_base}/api/v1/agents/ws?token={urllib.parse.quote(self.token)}&name={urllib.parse.quote(self.agent_name)}"

        active_prov = self._detect_provider()
        effective_model = self.model or ("gemini-1.5-flash" if active_prov == "gemini" else "llama3.1")

        print("=" * 60)
        print("  CME Local Agent Daemon (cme-agent)")
        print(f"  Name:      {self.agent_name}")
        print(f"  Server:    {self.server_url}")
        print(f"  Workspace: {self.workspace_dir}")
        print(f"  Tools:     {', '.join(sorted(self.allowed_tools))}")
        print(f"  Provider:  {active_prov} ({effective_model})")
        if self.api_base:
            print(f"  API Base:  {self.api_base}")
        print("=" * 60)

        backoff = 1.0
        while self.running:
            try:
                print(f"\n[AGENT] Connecting outbound to CME gateway at {self.server_url}...")
                async with websockets.connect(
                    ws_endpoint,
                    ping_interval=20,
                    ping_timeout=20,
                    max_size=16 * 1024 * 1024,
                ) as ws:
                    backoff = 1.0
                    print(f"[AGENT] Connection established. Listening for prompt requests...")

                    async for message in ws:
                        try:
                            data = json.loads(message)
                            msg_type = data.get("type", "")

                            if msg_type == "agent_ack":
                                print(f"[AGENT] Handshake acknowledged by server: version={data.get('server_version')}")
                            elif msg_type == "ping":
                                await ws.send(json.dumps({"type": "pong"}))
                            elif msg_type == "prompt_request":
                                asyncio.create_task(self.handle_prompt_request(ws, data))
                            else:
                                print(f"[AGENT] Received unhandled frame type: {msg_type}")
                        except Exception as e:
                            print(f"[AGENT] Error parsing frame: {e}", file=sys.stderr)

            except (websockets.exceptions.ConnectionClosedError, ConnectionRefusedError, OSError) as e:
                if not self.running:
                    break
                print(f"[AGENT] Connection lost: {e}. Reconnecting in {backoff:.1f}s...")
                await asyncio.sleep(backoff)
                backoff = min(backoff * 1.5, 30.0)
            except Exception as e:
                print(f"[AGENT] Unexpected error: {e}", file=sys.stderr)
                await asyncio.sleep(5.0)

    async def handle_prompt_request(self, ws, request: Dict[str, Any]):
        dialog_id = request.get("dialog_id", "")
        prompt = request.get("prompt", "")
        history = request.get("dialog_history", [])
        context = request.get("context", {})

        print(f"\n[PROMPT] Received request for dialog {dialog_id[:8]}...: '{prompt[:60]}'")

        active_prov = self._detect_provider()

        # Emit tool notice if context mentions local repo or files
        if "git" in self.allowed_tools and any(w in prompt.lower() for w in ["git", "commit", "branch", "diff", "log"]):
            await ws.send(json.dumps({
                "type": "tool_activity",
                "dialog_id": dialog_id,
                "tool": "local_git",
                "status": "inspecting repository",
            }))
            await asyncio.sleep(0.3)

        if active_prov == "gemini":
            await self._stream_gemini(ws, dialog_id, prompt, history, context)
        elif active_prov == "ollama":
            await self._stream_ollama(ws, dialog_id, prompt, history, context)
        elif active_prov in ("openai", "custom") or self.api_base:
            await self._stream_openai_compatible(ws, dialog_id, prompt, history, context)
        elif active_prov == "anthropic":
            await self._stream_anthropic(ws, dialog_id, prompt, history, context)
        else:
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_gemini(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        api_key = self._get_api_key("gemini")
        if not api_key:
            print("[WARN] No GEMINI_API_KEY found. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)
            return

        model_name = self.model or "gemini-1.5-flash"
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:streamGenerateContent?key={api_key}&alt=sse"

        # Build contents from history and context
        contents = []
        for h in history:
            role = "user" if h.get("role") == "user" else "model"
            contents.append({"role": role, "parts": [{"text": h.get("content", "")}]})

        user_text = prompt
        selected_text = context.get("selected_text", "")
        doc_title = context.get("document_title", "")
        if selected_text:
            user_text = f"Regarding document '{doc_title}':\n```markdown\n{selected_text}\n```\n\nPrompt: {prompt}"

        contents.append({"role": "user", "parts": [{"text": user_text}]})

        payload = {
            "contents": contents,
            "generationConfig": {
                "temperature": 0.7,
            }
        }

        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=60.0) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if decoded.startswith("data: "):
                        data_str = decoded[6:].strip()
                        if not data_str:
                            continue
                        try:
                            chunk = json.loads(data_str)
                            for cand in chunk.get("candidates", []):
                                for part in cand.get("content", {}).get("parts", []):
                                    text = part.get("text", "")
                                    if text:
                                        full_content += text
                                        await ws.send(json.dumps({
                                            "type": "token_stream",
                                            "dialog_id": dialog_id,
                                            "delta": text,
                                        }))
                        except Exception:
                            pass

            # Detect unified diff in markdown
            diff_match = re.search(r"```(?:diff)?\n(---.*?\n\+\+\+.*?\n@@.*?)```", full_content, re.DOTALL)
            if diff_match:
                await ws.send(json.dumps({
                    "type": "diff_proposal",
                    "dialog_id": dialog_id,
                    "document_id": context.get("document_id", ""),
                    "diff": diff_match.group(1).strip(),
                }))

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
            print(f"[PROMPT] Completed Gemini response ({len(full_content)} chars)")
        except Exception as e:
            print(f"[AGENT] Gemini streaming error: {e}. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_openai_compatible(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        api_base = self.api_base or "https://api.openai.com/v1"
        api_key = self._get_api_key("openai") or "none"
        model_name = self.model or "gpt-4o"

        url = f"{api_base.rstrip('/')}/chat/completions"

        messages = []
        for h in history:
            messages.append({"role": h.get("role", "user"), "content": h.get("content", "")})

        user_text = prompt
        selected_text = context.get("selected_text", "")
        doc_title = context.get("document_title", "")
        if selected_text:
            user_text = f"Context from '{doc_title}':\n```markdown\n{selected_text}\n```\n\n{prompt}"

        messages.append({"role": "user", "content": user_text})

        payload = {
            "model": model_name,
            "messages": messages,
            "stream": True,
        }

        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {api_key}",
                },
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=60.0) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if decoded.startswith("data: "):
                        data_str = decoded[6:].strip()
                        if data_str == "[DONE]":
                            break
                        try:
                            chunk = json.loads(data_str)
                            delta = chunk.get("choices", [{}])[0].get("delta", {}).get("content", "")
                            if delta:
                                full_content += delta
                                await ws.send(json.dumps({
                                    "type": "token_stream",
                                    "dialog_id": dialog_id,
                                    "delta": delta,
                                }))
                        except Exception:
                            pass

            diff_match = re.search(r"```(?:diff)?\n(---.*?\n\+\+\+.*?\n@@.*?)```", full_content, re.DOTALL)
            if diff_match:
                await ws.send(json.dumps({
                    "type": "diff_proposal",
                    "dialog_id": dialog_id,
                    "document_id": context.get("document_id", ""),
                    "diff": diff_match.group(1).strip(),
                }))

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except Exception as e:
            print(f"[AGENT] OpenAI-compatible stream error: {e}. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_ollama(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        try:
            payload = {
                "model": self.model or "llama3.1",
                "prompt": prompt,
                "stream": True,
            }
            req = urllib.request.Request(
                f"{self.ollama_host}/api/generate",
                data=json.dumps(payload).encode("utf-8"),
                headers={"Content-Type": "application/json"},
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=45.0) as resp:
                for line in resp:
                    if not line:
                        continue
                    try:
                        chunk = json.loads(line.decode("utf-8"))
                        token = chunk.get("response", "")
                        if token:
                            full_content += token
                            await ws.send(json.dumps({
                                "type": "token_stream",
                                "dialog_id": dialog_id,
                                "delta": token,
                            }))
                        if chunk.get("done", False):
                            break
                    except Exception:
                        pass

            diff_match = re.search(r"```(?:diff)?\n(---.*?\n\+\+\+.*?\n@@.*?)```", full_content, re.DOTALL)
            if diff_match:
                await ws.send(json.dumps({
                    "type": "diff_proposal",
                    "dialog_id": dialog_id,
                    "document_id": context.get("document_id", ""),
                    "diff": diff_match.group(1).strip(),
                }))

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except Exception as e:
            print(f"[AGENT] Ollama generation failed: {e}. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_anthropic(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        api_key = self._get_api_key("anthropic")
        if not api_key:
            await self._stream_echo(ws, dialog_id, prompt, history, context)
            return

        url = "https://api.anthropic.com/v1/messages"
        messages = []
        for h in history:
            messages.append({"role": h.get("role", "user"), "content": h.get("content", "")})
        messages.append({"role": "user", "content": prompt})

        payload = {
            "model": self.model or "claude-3-5-sonnet-20241022",
            "messages": messages,
            "max_tokens": 4096,
            "stream": True,
        }

        try:
            req = urllib.request.Request(
                url,
                data=json.dumps(payload).encode("utf-8"),
                headers={
                    "Content-Type": "application/json",
                    "x-api-key": api_key,
                    "anthropic-version": "2023-06-01",
                },
                method="POST"
            )

            full_content = ""
            with urllib.request.urlopen(req, timeout=60.0) as resp:
                for line in resp:
                    decoded = line.decode("utf-8").strip()
                    if decoded.startswith("data: "):
                        data_str = decoded[6:].strip()
                        try:
                            chunk = json.loads(data_str)
                            if chunk.get("type") == "content_block_delta":
                                delta = chunk.get("delta", {}).get("text", "")
                                if delta:
                                    full_content += delta
                                    await ws.send(json.dumps({
                                        "type": "token_stream",
                                        "dialog_id": dialog_id,
                                        "delta": delta,
                                    }))
                        except Exception:
                            pass

            await ws.send(json.dumps({
                "type": "prompt_complete",
                "dialog_id": dialog_id,
                "content": full_content,
            }))
        except Exception as e:
            print(f"[AGENT] Anthropic streaming error: {e}. Falling back to local responder.", file=sys.stderr)
            await self._stream_echo(ws, dialog_id, prompt, history, context)

    async def _stream_echo(self, ws, dialog_id: str, prompt: str, history: List[Any], context: Dict[str, Any]):
        doc_info = context.get("document_title") or context.get("document_id") or ""
        selected_text = context.get("selected_text", "")

        response_chunks = [
            f"Hello! I am your local AI agent daemon (`{self.agent_name}`).\n\n",
            f"I received your request: \"{prompt}\".\n\n",
        ]

        if selected_text:
            response_chunks.append(f"Regarding your selected document context:\n> {selected_text.strip()}\n\n")

        response_chunks.append("Running locally on your workstation, I have direct access to your local files and CLI tools without exposing inbound network ports.\n")

        full_content = ""
        for chunk in response_chunks:
            full_content += chunk
            await ws.send(json.dumps({
                "type": "token_stream",
                "dialog_id": dialog_id,
                "delta": chunk,
            }))
            await asyncio.sleep(0.04)

        if any(w in prompt.lower() for w in ["refactor", "diff", "edit", "change", "replace", "fix"]):
            diff_text = "--- a/document.md\n+++ b/document.md\n@@ -1,3 +1,3 @@\n-Draft section\n+Refactored section: verified by local agent\n"
            await ws.send(json.dumps({
                "type": "diff_proposal",
                "dialog_id": dialog_id,
                "document_id": context.get("document_id", ""),
                "diff": diff_text,
            }))

        await ws.send(json.dumps({
            "type": "prompt_complete",
            "dialog_id": dialog_id,
            "content": full_content,
        }))
        print(f"[PROMPT] Completed response for dialog {dialog_id[:8]}")


def main():
    parser = argparse.ArgumentParser(
        description="CME Local Agent CLI Daemon - Bridges Gemini, Ollama, Anthropic, OpenAI & local tools with CME."
    )
    parser.add_argument(
        "--server", "-s",
        type=str,
        default="http://localhost:18080",
        help="CME Server URL (e.g., http://localhost:18080 or https://editor.example.com)"
    )
    parser.add_argument(
        "--token", "-t",
        type=str,
        required=True,
        help="Cryptographic agent pairing token generated in CME UI"
    )
    parser.add_argument(
        "--name", "-n",
        type=str,
        default=f"{socket.gethostname()}-agent",
        help="Human-readable name identifying this agent in CME"
    )
    parser.add_argument(
        "--provider", "-p",
        type=str,
        default="auto",
        help="Inference provider: gemini, ollama, anthropic, openai, custom, echo (default: auto)"
    )
    parser.add_argument(
        "--model", "-m",
        type=str,
        default=None,
        help="Model identifier (e.g., gemini-1.5-flash, llama3.1, claude-3-5-sonnet, gpt-4o)"
    )
    parser.add_argument(
        "--api-key", "-k",
        type=str,
        default=None,
        help="API key for Gemini, Anthropic, OpenAI, or custom endpoint (can also use env vars)"
    )
    parser.add_argument(
        "--api-base", "--base-url",
        type=str,
        default=None,
        help="Custom OpenAI-compatible base URL (e.g. http://localhost:8000/v1 or https://api.groq.com/openai/v1)"
    )
    parser.add_argument(
        "--ollama-host",
        type=str,
        default="http://localhost:11434",
        help="Local Ollama service URL (default: http://localhost:11434)"
    )
    parser.add_argument(
        "--allow-tools",
        type=str,
        default="git,grep,filesystem",
        help="Comma-separated local workstation tools allowed"
    )
    parser.add_argument(
        "--workspace",
        type=str,
        default=None,
        help="Root workspace path for local tool executions (default: cwd)"
    )

    args = parser.parse_args()

    tools = [t.strip() for t in args.allow_tools.split(",") if t.strip()]

    agent = CMEAgentDaemon(
        server_url=args.server,
        token=args.token,
        agent_name=args.name,
        provider=args.provider,
        model=args.model,
        api_key=args.api_key,
        api_base=args.api_base,
        ollama_host=args.ollama_host,
        allowed_tools=tools,
        workspace_dir=args.workspace,
    )

    try:
        asyncio.run(agent.run())
    except KeyboardInterrupt:
        print("\n[AGENT] Stopped by user.")


if __name__ == "__main__":
    main()
